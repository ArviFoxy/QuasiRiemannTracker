disc(E=a^2, s=b^2) = (Q*a**2 - 4*Q*a*b - 2*Q + 5*a**2 + 20*a*b + 20*b**2)*(Q*a**2 + 4*Q*a*b - 2*Q + 5*a**2 - 20*a*b + 20*b**2)
