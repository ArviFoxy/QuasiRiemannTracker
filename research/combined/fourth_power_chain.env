export QRH_START=99999/100000,93/25,3/50                          # first parent: Sil's fourth-power source face (B, L, cap)
export QRH_SIG=0.0329365,0.0376,0.0423,0.0472                     # face-family breakpoints (start at the tangency; end before L/B < 3, the q floor)
export QRH_PKG=Submissions.arvi_fourth_power_chain_20261025
export QRH_NATURAL=QRH.RepeatedMarks.start                        # Lean name of the first parent
