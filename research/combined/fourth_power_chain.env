export QRH_THETA=8746075/10000000                                 # final return: target θ* (theta_family2.py)
export QRH_H=401/500                                              # conductor top h
export QRH_CAP=549989/10000000                                    # caps of the final count and physical faces
export QRH_SC=13/250                                              # constant-width cap of the count face
