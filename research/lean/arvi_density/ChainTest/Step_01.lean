theorem markedHigh : ∃ r : ℝ, 0 < r ∧ ∀ v, 0 ≤ v → v ≤ (1 / 10 : ℝ) - cross (99999 / 100000 : ℝ) (5143 / 2000 : ℝ) (2499583 / 2500000 : ℝ) (5133 / 2000 : ℝ) → ∀ ν,
