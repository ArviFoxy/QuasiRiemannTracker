# Fallback design (a) of the final return: Lemma W windows with the face caps 3/40 (faces_k92.json), for
# when the source side's cap ramp is not ready. Same ReturnD as design (b) (same QRH_RELAXED, SP, DMINUS),
# so switching between (a) and (b) rebuilds FinalReturn only.  usage: QRH_ENV=.../return_cut_a.env ./run_all.sh W
source /home/user/QuasiRiemannTracker/research/mixed-step/return_cut/return_cut.env
export QRH_FACES=/home/user/QuasiRiemannTracker/research/mixed-step/faces_k92.json        # caps 3/40
export QRH_THETA=874137/1000000                                   # theta = 0.874137 (exact theta* = 0.8741351 at this h)
export QRH_H=803/1000                                             # h = 0.803 (theta* flat at 0.874135x for h in [0.8025, 0.8035])
