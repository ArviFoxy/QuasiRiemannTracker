theorem unifSecondDiag : UnifPos (gSecondDiag (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ) (6 / 5 : ℝ) (140 : ℝ)) 0 ((1 / 10 : ℝ) - cross (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ)) := by
  refine ⟨(791 / 80000 : ℝ), by norm_num, fun v h0 h1 => reserveSecondDiag v h0 ?_⟩
