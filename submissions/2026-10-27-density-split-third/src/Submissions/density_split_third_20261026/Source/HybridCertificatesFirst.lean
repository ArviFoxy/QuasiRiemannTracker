/-! #### Gate `reference_upper_positive` -/

def nRefUpper (v : ℝ) : ℝ := (7 : ℝ) + (812 : ℝ) * v + ((-8400) : ℝ) * v ^ 2

def dRefUpper (v : ℝ) : ℝ := (30 : ℝ) + (4200 : ℝ) * v

theorem clearedRefUpper (v : ℝ) (h0 : 0 ≤ v) :
    gRefUpper (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ) (6 / 5 : ℝ) (140 : ℝ) v * dRefUpper v = nRefUpper v := by
  have hx : 1 + (140 : ℝ) * v ≠ 0 := (x_pos v h0).ne'
  refine mul_eq_of_cleared (hx) (gRefUpper_mul (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ) (6 / 5 : ℝ) (140 : ℝ) v hx) ?_
  simp only [nRefUpper, dRefUpper, width, cross_eq]
  ring

theorem nRefUpper_bern0 (t : ℝ) : nRefUpper ((0 : ℝ) + ((1 / 20 : ℝ) - (0 : ℝ)) * t) = bern2 (7 : ℝ) (273 / 10 : ℝ) (133 / 5 : ℝ) t := by
  unfold nRefUpper bern2; ring
theorem dRefUpper_bern0 (t : ℝ) : dRefUpper ((0 : ℝ) + ((1 / 20 : ℝ) - (0 : ℝ)) * t) = bern1 (30 : ℝ) (240 : ℝ) t := by
  unfold dRefUpper bern1; ring
theorem boxRefUpper_0 (v : ℝ) (h0 : (0 : ℝ) ≤ v) (h1 : v ≤ (1 / 20 : ℝ)) :
    (7 / 240 : ℝ) ≤ gRefUpper (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ) (6 / 5 : ℝ) (140 : ℝ) v := by
  have hb := box_lower (g := gRefUpper (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ) (6 / 5 : ℝ) (140 : ℝ)) (n := nRefUpper) (d := dRefUpper)
    (lo := (0 : ℝ)) (hi := (1 / 20 : ℝ)) (m := (7 : ℝ)) (M := (240 : ℝ)) (by norm_num) (by norm_num)
    (fun v h0 _ => clearedRefUpper v (by linarith))
    (fun t ht ht' => by
      rw [nRefUpper_bern0]
      exact bern2_ge ht ht' (by norm_num) (by norm_num) (by norm_num))
    (fun t ht ht' => by
      rw [dRefUpper_bern0]
      exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < (30 : ℝ))
        (bern1_ge ht ht' (by norm_num) (by norm_num)))
    (fun t ht ht' => by
      rw [dRefUpper_bern0]
      exact bern1_le ht ht' (by norm_num) (by norm_num))
    v h0 h1
  exact le_trans (le_of_eq (by norm_num)) hb

/-- Explicit uniform reserve of `reference_upper_positive` on `[0, 1/20]`. -/
theorem reserveRefUpper (v : ℝ) (h0 : 0 ≤ v) (h1 : v ≤ (1 / 20 : ℝ)) :
    (7 / 240 : ℝ) ≤ gRefUpper (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ) (6 / 5 : ℝ) (140 : ℝ) v := by
  exact boxRefUpper_0 v h0 h1

theorem unifRefUpper : UnifPos (gRefUpper (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ) (6 / 5 : ℝ) (140 : ℝ)) 0 ((1 / 10 : ℝ) - cross (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ)) := by
  refine ⟨(7 / 240 : ℝ), by norm_num, fun v h0 h1 => reserveRefUpper v h0 ?_⟩
  rw [cross_eq] at h1; linarith

/-! #### Gate `selection_monotonicity` -/

def nSelDeriv (_v : ℝ) : ℝ := (6 : ℝ)

def dSelDeriv (v : ℝ) : ℝ := (5 : ℝ) + (1400 : ℝ) * v + (98000 : ℝ) * v ^ 2

theorem clearedSelDeriv (v : ℝ) (h0 : 0 ≤ v) :
    gSelDeriv (6 / 5 : ℝ) (140 : ℝ) v * dSelDeriv v = nSelDeriv v := by
  have hx : 1 + (140 : ℝ) * v ≠ 0 := (x_pos v h0).ne'
  refine mul_eq_of_cleared (pow_ne_zero 2 hx) (gSelDeriv_mul (6 / 5 : ℝ) (140 : ℝ) v hx) ?_
  simp only [nSelDeriv, dSelDeriv]
  ring

theorem nSelDeriv_bern0 (t : ℝ) : nSelDeriv ((0 : ℝ) + ((1 / 20 : ℝ) - (0 : ℝ)) * t) = bern0 (6 : ℝ) t := by
  unfold nSelDeriv bern0; ring
theorem dSelDeriv_bern0 (t : ℝ) : dSelDeriv ((0 : ℝ) + ((1 / 20 : ℝ) - (0 : ℝ)) * t) = bern2 (5 : ℝ) (40 : ℝ) (320 : ℝ) t := by
  unfold dSelDeriv bern2; ring
theorem boxSelDeriv_0 (v : ℝ) (h0 : (0 : ℝ) ≤ v) (h1 : v ≤ (1 / 20 : ℝ)) :
    (3 / 160 : ℝ) ≤ gSelDeriv (6 / 5 : ℝ) (140 : ℝ) v := by
  have hb := box_lower (g := gSelDeriv (6 / 5 : ℝ) (140 : ℝ)) (n := nSelDeriv) (d := dSelDeriv)
    (lo := (0 : ℝ)) (hi := (1 / 20 : ℝ)) (m := (6 : ℝ)) (M := (320 : ℝ)) (by norm_num) (by norm_num)
    (fun v h0 _ => clearedSelDeriv v (by linarith))
    (fun t ht ht' => by
      rw [nSelDeriv_bern0]
      exact bern0_ge (by norm_num))
    (fun t ht ht' => by
      rw [dSelDeriv_bern0]
      exact lt_of_lt_of_le (by norm_num : (0 : ℝ) < (5 : ℝ))
        (bern2_ge ht ht' (by norm_num) (by norm_num) (by norm_num)))
    (fun t ht ht' => by
      rw [dSelDeriv_bern0]
      exact bern2_le ht ht' (by norm_num) (by norm_num) (by norm_num))
    v h0 h1
  exact le_trans (le_of_eq (by norm_num)) hb

/-- Explicit uniform reserve of `selection_monotonicity` on `[0, 1/20]`. -/
theorem reserveSelDeriv (v : ℝ) (h0 : 0 ≤ v) (h1 : v ≤ (1 / 20 : ℝ)) :
    (3 / 160 : ℝ) ≤ gSelDeriv (6 / 5 : ℝ) (140 : ℝ) v := by
  exact boxSelDeriv_0 v h0 h1

theorem unifSelDeriv : UnifPos (gSelDeriv (6 / 5 : ℝ) (140 : ℝ)) 0 ((1 / 10 : ℝ) - cross (9999 / 10000 : ℝ) (129 / 50 : ℝ) (9959 / 10000 : ℝ) (5 / 2 : ℝ)) := by
  refine ⟨(3 / 160 : ℝ), by norm_num, fun v h0 h1 => reserveSelDeriv v h0 ?_⟩
  rw [cross_eq] at h1; linarith

end HybridFirst

