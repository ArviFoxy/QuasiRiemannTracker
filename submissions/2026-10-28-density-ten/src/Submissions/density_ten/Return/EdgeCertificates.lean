 rcases le_total p (1/4:ℝ) with hs | hs
 · exact envelope_row013 hδ ⟨hp.1,hs⟩
 · exact cover_newTop_024 hδ ⟨hs,hp.2⟩
theorem cover_newTop_026 {δ p : ℝ} (hδ : δ ∈ Set.Icc (0:ℝ) (3/4:ℝ))
 (hp : p ∈ Set.Icc (0:ℝ) (1/2:ℝ)) : Ebase (edgeD .newTop) (edgeC .newTop) δ p+3/4*edgeD .newTop*(@GenericCount.envelope finalCountScheme kappa δ p)<theta-reserve := by
 rcases le_total δ (3/8:ℝ) with hs | hs
 · exact cover_newTop_006 ⟨hδ.1,hs⟩ hp
 · exact cover_newTop_025 ⟨hs,hδ.2⟩ hp
theorem edge_newTop_certificate {δ p:ℝ} (hδ:δ∈Set.Icc 0 (3/4))
 (hp:p∈Set.Icc 0 (1/2)) : Ebase (edgeD .newTop) (edgeC .newTop) δ p+3/4*edgeD .newTop*(@GenericCount.envelope finalCountScheme kappa δ p)<theta-reserve := by
 exact cover_newTop_026 (by simpa using hδ) (by simpa using hp)
theorem closed_envelope_return_cover (e : Edge) {δ p : ℝ} (hδ : δ∈Set.Icc 0 (3/4))
 (hp : p∈Set.Icc 0 (1/2)) : Ebase (edgeD e) (edgeC e) δ p+3/4*edgeD e*(@GenericCount.envelope finalCountScheme kappa δ p)<theta-reserve := by
 cases e with
 | oldSmall => exact edge_oldSmall_certificate hδ hp
 | oldSwitch => exact edge_oldSwitch_certificate hδ hp
 | newSwitch => exact edge_newSwitch_certificate hδ hp
 | newTop => exact edge_newTop_certificate hδ hp
end
end QRH.DensityTen.Return.FinalEdges
